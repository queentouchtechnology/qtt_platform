#!/bin/sh
# Set up once per clone:  git config core.hooksPath .githooks
# Every staged Python file must compile.
py=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')
if [ -n "$py" ]; then
  python -m py_compile $py || { echo "Python syntax error above — fix it before committing."; exit 1; }
fi
# Backend guide (Desk › QTT API Endpoint, api_guide.json): it must match the code. A new endpoint needs a
# docstring (its purpose in the guide). Generated by qtt-os/tool/api_guide.py (the app lives in qtt-os).
if [ -f ../qtt-os/tool/api_guide.py ] && git diff --cached --name-only | grep -q -E '\.py$|^qtt_platform/www/|api_guide\.json$'; then
  (cd ../qtt-os && python tool/api_guide.py) || { echo "Backend guide: add the docstrings listed above."; exit 1; }
  git add qtt_platform/api_guide.json
fi
# The App Map (developers' tree of the whole system, app_map.json): follows the guide, screens and folders.
if [ -f ../qtt-os/tool/app_map.py ] && git diff --cached --name-only | grep -q -E '\.py$|\.json$|^qtt_platform/www/'; then
  (cd ../qtt-os && python tool/app_map.py) || { echo "App Map failed — see above."; exit 1; }
  git add qtt_platform/app_map.json
fi
