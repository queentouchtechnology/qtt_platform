{
 "doctype": "DocType",
 "name": "QTT Invoice",
 "module": "QTT Platform",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "quick_entry": 0,
 "track_changes": 1,
 "autoname": "INV-.YYYY.-.#####",
 "naming_rule": "Expression",
 "sort_field": "creation",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "description": "What a tenant owes, possibly across several product subscriptions (see QTT Invoice Item). Editable only while status='draft' — frozen once issued, per the hardening review section 11's immutability classification: amount is fixed at issue time, a later QTT Plan.base_price change never retroactively rewrites an existing invoice. No tenant-facing role holds DocPerm here; every read/write goes through api/billing.py.",
 "field_order": [
  "tenant",
  "column_break_amount",
  "amount",
  "currency",
  "status",
  "due_date",
  "section_break_items",
  "items"
 ],
 "fields": [
  {
   "fieldname": "tenant",
   "fieldtype": "Link",
   "label": "Tenant",
   "options": "QTT Tenant",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_amount",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Must equal the sum of `items`, enforced in validate()."
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "reqd": 1,
   "default": "INR"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "draft\nopen\npaid\nvoid",
   "default": "draft",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "due_date",
   "fieldtype": "Date",
   "label": "Due Date",
   "reqd": 1
  },
  {
   "fieldname": "section_break_items",
   "fieldtype": "Section Break",
   "label": "Line Items"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "QTT Invoice Item",
   "reqd": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "links": []
}
