  {
   "fieldname": "column_break_signup",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "whatsapp_otp_template",
   "fieldtype": "Data",
   "label": "WhatsApp code template",
   "default": "reference_number",
   "description": "A Meta-approved template whose {{1}} is the code, e.g. reference_number."
  },
  {
   "fieldname": "whatsapp_otp_language",
   "fieldtype": "Data",
   "label": "Template language",
   "default": "en"
  },
  {
   "fieldname": "section_quick_login",
   "fieldtype": "Section Break",
   "label": "One-touch sign-in",
   "description": "Sign in with Google, and with fingerprint / Face ID on phones that signed in once before."
  },
  {
   "fieldname": "google_sign_in",
   "fieldtype": "Check",
   "label": "Sign in with Google",
   "default": "1",
