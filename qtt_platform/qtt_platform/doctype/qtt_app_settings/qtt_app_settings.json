  {
   "fieldname": "support_email",
   "fieldtype": "Data",
   "label": "Support email",
   "options": "Email"
  },
  {
   "fieldname": "column_break_support",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "support_hours",
   "fieldtype": "Data",
   "label": "Support hours",
   "description": "e.g. Mon–Sat, 9 am – 7 pm"
  },
  {
   "fieldname": "section_signup",
   "fieldtype": "Section Break",
   "label": "Sign-up security",
   "description": "New business owners prove their email and WhatsApp number with a one-time code before the account is created."
  },
  {
   "fieldname": "signup_verify_email",
   "fieldtype": "Check",
