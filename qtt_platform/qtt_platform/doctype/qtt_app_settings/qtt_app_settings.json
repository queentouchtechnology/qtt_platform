  },
  {
   "fieldname": "google_client_ids",
   "fieldtype": "Small Text",
   "label": "Other Google client IDs",
   "description": "Only if the app's ID tokens are issued for a different client ID — one per line."
  },
  {
   "fieldname": "column_break_quick_login",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "biometric_sign_in",
   "fieldtype": "Check",
   "label": "Fingerprint / Face ID sign-in",
   "default": "1",
   "description": "Trusted phones are listed in QTT Trusted Device."
  },
  {
