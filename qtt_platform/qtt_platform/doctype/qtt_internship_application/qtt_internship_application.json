{
 "doctype": "DocType",
 "name": "QTT Internship Application",
 "module": "QTT Platform",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "autoname": "hash",
 "track_changes": 1,
 "sort_field": "creation",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "title_field": "applicant_name",
 "show_title_field_in_link": 1,
 "description": "Internship applications from queentouchtech.in/internship/ (qtt_platform.api.internship) — the same details as the team's WhatsApp message (personal and academic, requirements, technical background, what the college needs, documents). The applicant gets an email; the owner a Telegram. Move each through Status.",
 "field_order": [
  "applicant_name",
  "email",
  "phone",
  "city",
  "column_break_who",
  "status",
  "area",
  "mode",
  "section_study",
  "college",
  "course",
  "column_break_study",
  "year_of_study",
  "start_date",
  "end_date",
  "duration",
  "mandatory",
  "has_request_letter",
  "section_about",
  "skills",
  "languages",
  "tools",
  "projects",
  "previous_internship",
  "portfolio",
  "why",
  "section_college",
  "needs_report",
  "needs_certificate",
  "needs_progress_reports",
  "column_break_college",
  "college_guidelines",
  "section_documents",
  "resume",
  "college_id",
  "request_letter",
  "section_team",
  "notes",
  "column_break_team",
  "site",
  "page"
 ],
 "fields": [
  {
   "fieldname": "applicant_name",
   "fieldtype": "Data",
   "label": "Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Email",
   "options": "Email",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Phone or WhatsApp",
   "options": "Phone"
  },
  {
   "fieldname": "city",
   "fieldtype": "Data",
   "label": "City"
  },
  {
   "fieldname": "column_break_who",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "New\nShortlisted\nInterview\nSelected\nRejected\nWithdrawn",
   "default": "New",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "area",
   "fieldtype": "Select",
   "label": "Area",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Flutter app development\nBackend (Python, Frappe)\nWebsites and SEO\nUI / UX design\nAI and automation\nDigital marketing and content\nSales and customer success\nOther"
  },
  {
   "fieldname": "mode",
   "fieldtype": "Select",
   "label": "Mode",
   "options": "Online\nOffline\nEither"
  },
  {
   "fieldname": "section_study",
   "fieldtype": "Section Break",
   "label": "Study"
  },
  {
   "fieldname": "college",
   "fieldtype": "Data",
   "label": "College or university"
  },
  {
   "fieldname": "course",
   "fieldtype": "Data",
   "label": "Department / specialization"
  },
  {
   "fieldname": "column_break_study",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "year_of_study",
   "fieldtype": "Select",
   "label": "Current year",
   "options": "\n1st year\n2nd year\n3rd year\n4th year\nFinal year\nGraduated"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start date"
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End date"
  },
  {
   "fieldname": "duration",
   "fieldtype": "Select",
   "label": "Duration",
   "options": "\n2 weeks\n1 month\n2 months\n3 months\n6 months"
  },
  {
   "fieldname": "mandatory",
   "fieldtype": "Select",
   "label": "Mandatory as per curriculum",
   "options": "\nYes\nNo"
  },
  {
   "fieldname": "has_request_letter",
   "fieldtype": "Select",
   "label": "College request letter available",
   "options": "\nYes\nNo"
  },
  {
   "fieldname": "section_about",
   "fieldtype": "Section Break",
   "label": "About them"
  },
  {
   "fieldname": "skills",
   "fieldtype": "Small Text",
   "label": "Skills (older applications)",
   "hidden": 1
  },
  {
   "fieldname": "languages",
   "fieldtype": "Small Text",
   "label": "Programming languages"
  },
  {
   "fieldname": "tools",
   "fieldtype": "Small Text",
   "label": "Tools / technologies"
  },
  {
   "fieldname": "projects",
   "fieldtype": "Long Text",
   "label": "Previous projects"
  },
  {
   "fieldname": "previous_internship",
   "fieldtype": "Small Text",
   "label": "Previous internship"
  },
  {
   "fieldname": "portfolio",
   "fieldtype": "Data",
   "label": "Portfolio, GitHub or LinkedIn",
   "options": "URL"
  },
  {
   "fieldname": "why",
   "fieldtype": "Long Text",
   "label": "Why this internship (optional)"
  },
  {
   "fieldname": "section_college",
   "fieldtype": "Section Break",
   "label": "What the college needs"
  },
  {
   "fieldname": "needs_report",
   "fieldtype": "Select",
   "label": "Project report needed",
   "options": "\nYes\nNo"
  },
  {
   "fieldname": "needs_certificate",
   "fieldtype": "Select",
   "label": "Completion certificate needed",
   "options": "\nYes\nNo"
  },
  {
   "fieldname": "needs_progress_reports",
   "fieldtype": "Select",
   "label": "Mentor evaluation / progress reports needed",
   "options": "\nYes\nNo"
  },
  {
   "fieldname": "column_break_college",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "college_guidelines",
   "fieldtype": "Small Text",
   "label": "College guidelines"
  },
  {
   "fieldname": "section_documents",
   "fieldtype": "Section Break",
   "label": "Documents"
  },
  {
   "fieldname": "resume",
   "fieldtype": "Attach",
   "label": "Resume"
  },
  {
   "fieldname": "college_id",
   "fieldtype": "Attach",
   "label": "College ID card"
  },
  {
   "fieldname": "request_letter",
   "fieldtype": "Attach",
   "label": "Internship request letter"
  },
  {
   "fieldname": "section_team",
   "fieldtype": "Section Break",
   "label": "For the QTT team"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "column_break_team",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "site",
   "fieldtype": "Data",
   "label": "From site",
   "read_only": 1
  },
  {
   "fieldname": "page",
   "fieldtype": "Data",
   "label": "From page",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "links": []
}
